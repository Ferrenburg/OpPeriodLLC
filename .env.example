# Copy to .env.local for local development. In production these go in
# Vercel, under Settings, then Environment Variables. See README.md.

# Resend API key, from resend.com/api-keys. Without it, local dev prints
# messages to the terminal instead of sending; production refuses to send.
RESEND_API_KEY=

# The From address on contact form emails. Its domain must be verified in
# Resend. Replies go to whoever filled out the form, not to this address.
CONTACT_FROM_EMAIL="OpPeriod Website <website@opperiod.com>"

# Where messages go when a project has no inbox of its own.
CONTACT_EMAIL_DEFAULT=sales@opperiod.com

# A project with contactEmailKey: BOX_ALARM in its file sends to
# CONTACT_EMAIL_BOX_ALARM. Leave unset to use the default.
# CONTACT_EMAIL_BOX_ALARM=

# Cloudflare Turnstile spam check, from dash.cloudflare.com under Turnstile.
# Turned on only when both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Overrides https://opperiod.com in links and social previews.
# SITE_URL=

# Engine Bay is served at the root of enginebaysupply.com in production
# (VERCEL_ENV=production) and under /engine-bay everywhere else. Set this to
# true to build the production layout locally (send Host: enginebaysupply.com).
# ENGINE_BAY_OWN_DOMAIN=true

# Engine Bay online shop (lib/shop.ts). Off unless SHOP_ENABLED=true and a
# Stripe key is set. Off, the site is quote only, exactly as before.
# SHOP_ENABLED=true
# A Stripe restricted key with read access to Products, Prices, Checkout
# Sessions, Charges, and Payment Intents, and write access to Checkout Sessions.
# STRIPE_SECRET_KEY=rk_live_...
# The signing secret of the webhook endpoint pointed at /api/stripe/webhook.
# STRIPE_WEBHOOK_SECRET=whsec_...
# Optional override of the flat shipping rates in lib/engine-bay.ts
# (shopShippingRates), dollars, first item + each additional, every class.
# SHOP_SHIPPING_RATES=standard=19+8,long=59+39,hose=24+14,ldh=95+75,saw=45+25
# Optional line under prices, like "Ships direct from the manufacturer in 5 to 10 business days."
# SHOP_LEAD_TIME=
# Where order emails go. Defaults to CONTACT_EMAIL_DEFAULT.
# SHOP_ORDER_EMAIL=
# Set to false to turn off Stripe Tax at checkout (it's on by default).
# SHOP_AUTOMATIC_TAX=
