# Copy to .env.local for local development. In production these go in
# Vercel, under Settings, then Environment Variables. See README.md.

# Resend API key, from resend.com/api-keys. Without it, local dev prints
# messages to the terminal instead of sending; production refuses to send.
RESEND_API_KEY=

# The From address on contact form emails. Its domain must be verified in
# Resend. Replies go to whoever filled out the form, not to this address.
CONTACT_FROM_EMAIL="Opperiod Website <website@opperiod.com>"

# Where messages go when a project has no inbox of its own.
CONTACT_EMAIL_DEFAULT=sales@opperiod.com

# A project with contactEmailKey: BOX_ALARM in its file sends to
# CONTACT_EMAIL_BOX_ALARM. Leave unset to use the default.
# CONTACT_EMAIL_BOX_ALARM=

# Cloudflare Turnstile spam check, from dash.cloudflare.com under Turnstile.
# Turned on only when both are set.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional. Overrides https://opperiod.com in links and social previews.
# SITE_URL=
